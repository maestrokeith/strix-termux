# STRIX local configuration
# Copy this file to .env. Never commit .env.

# Autonomous paper mode: scans and manages simulated positions continuously.
STRIX_DRY=1
STRIX_AUTOPILOT=1
STRIX_RESERVE=0.01
STRIX_MAX_ORDER=0.08
PORT=8787

# Optional in paper mode. If provided, STRIX reads that wallet's public address
# and on-chain SOL balance but still does NOT send transactions while STRIX_DRY=1.
STRIX_SECRET=
